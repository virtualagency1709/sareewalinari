# =====================================================================
# SAREE WALI NARI — ENVIRONMENT VARIABLES CONFIGURATION
# =====================================================================

# 1. Supabase PostgreSQL Database & Auth
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Razorpay Indian Payment Gateway (Optional - Sandbox Mode active by default)
# Get these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# 3. Application Domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
